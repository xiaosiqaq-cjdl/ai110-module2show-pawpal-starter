classDiagram

    class Owner {
        +String name
        +List pets
        +Dictionary preferences
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +String name
        +String species
        +List tasks
        +add_task(task)
    }

    class Task {
        +String title
        +int duration_minutes
        +String priority
        +String scheduled_time
        +String frequency
        +bool completed
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +sort_by_priority_and_time(tasks)
        +filter_tasks(tasks)
        +build_daily_plan(available_minutes)
        +detect_conflicts(tasks)
    }

    Owner "1" --> "0..*" Pet : manages
    Pet "1" --> "0..*" Task : contains
    Scheduler --> Owner : retrieves tasks from